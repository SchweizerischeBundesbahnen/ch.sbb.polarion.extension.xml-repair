{
  "openapi": "3.0.1",
  "info": {
    "title": "XML Repair REST API",
    "version": "v1"
  },
  "paths": {
    "/api/baselines": {
      "get": {
        "operationId": "listBaselines",
        "parameters": [
          {
            "description": "Project ID",
            "in": "query",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BaselineInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved the list of baselines"
          }
        },
        "summary": "Get list of baselines for the specified project",
        "tags": [
          "XML Repair"
        ]
      }
    },
    "/api/configuration-properties": {
      "get": {
        "operationId": "getConfigurationProperties",
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigurationPropertiesModel"
                }
              }
            },
            "description": "Configuration properties"
          }
        },
        "summary": "Returns the extension configuration properties (active and obsolete)",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/configuration-status": {
      "get": {
        "operationId": "getConfigurationStatus",
        "parameters": [
          {
            "description": "Scope to evaluate the status for, e.g. 'project/elibrary/'",
            "in": "query",
            "name": "scope",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConfigurationStatus"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Configuration status entries"
          }
        },
        "summary": "Returns the extension configuration status for the given scope",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/context": {
      "get": {
        "operationId": "getContext",
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Context"
                }
              }
            },
            "description": "Context information"
          }
        },
        "summary": "Returns basic context information of Polarion's extension",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/document-types": {
      "get": {
        "operationId": "listDocumentTypes",
        "parameters": [
          {
            "description": "Project ID",
            "in": "query",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TypeInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved the list of document types"
          }
        },
        "summary": "Get list of document types for the specified project",
        "tags": [
          "XML Repair"
        ]
      }
    },
    "/api/readme": {
      "get": {
        "operationId": "getDocumentation",
        "responses": {
          "default": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "HTML help article"
          }
        },
        "summary": "Returns the build-generated README help article shown on the About page",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/repair": {
      "post": {
        "operationId": "repair",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepairParams"
              }
            }
          },
          "description": "Repair parameters",
          "required": true
        },
        "responses": {
          "200": {
            "description": "Processing completed successfully"
          }
        },
        "summary": "Repair XML issues in the specified entity",
        "tags": [
          "XML Repair"
        ]
      }
    },
    "/api/repairers": {
      "get": {
        "operationId": "listRepairers",
        "parameters": [
          {
            "description": "Entity type",
            "in": "query",
            "name": "entityType",
            "required": true,
            "schema": {
              "enum": [
                "COLLECTION",
                "DOCUMENT",
                "WORKITEM"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RepairerMeta"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved the list of available repairers"
          }
        },
        "summary": "Get list of available repairers for the specified entity type",
        "tags": [
          "XML Repair"
        ]
      }
    },
    "/api/roles": {
      "get": {
        "operationId": "listRoles",
        "parameters": [
          {
            "description": "Scope, e.g. project/<projectId>/ (empty for global scope)",
            "in": "query",
            "name": "scope",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RolesInfo"
                }
              }
            },
            "description": "Successfully retrieved the available roles"
          }
        },
        "summary": "Get the global and project roles available for repair authorization in the specified scope",
        "tags": [
          "XML Repair"
        ]
      }
    },
    "/api/scan": {
      "post": {
        "operationId": "scan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanParams"
              }
            }
          },
          "description": "Scan parameters",
          "required": true
        },
        "responses": {
          "200": {
            "description": "Scan completed successfully"
          }
        },
        "summary": "Scan a list of entities for XML issues based on the provided parameters",
        "tags": [
          "XML Repair"
        ]
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "readFeaturesList",
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "List of supported features"
          }
        },
        "summary": "Returns the complete list of all supported features",
        "tags": [
          "Settings"
        ]
      }
    },
    "/api/settings/{feature}/default-content": {
      "get": {
        "operationId": "getDefaultValues",
        "parameters": [
          {
            "in": "path",
            "name": "feature",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsModel"
                }
              }
            },
            "description": "Default values"
          }
        },
        "summary": "Returns default values of specified setting",
        "tags": [
          "Settings"
        ]
      }
    },
    "/api/settings/{feature}/names": {
      "get": {
        "operationId": "readSettingNames",
        "parameters": [
          {
            "in": "path",
            "name": "feature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingName"
                }
              }
            },
            "description": "List of setting names"
          }
        },
        "summary": "Returns names of specified setting in specified scope (global or certain project)",
        "tags": [
          "Settings"
        ]
      }
    },
    "/api/settings/{feature}/names/{name}": {
      "delete": {
        "operationId": "deleteSetting",
        "parameters": [
          {
            "in": "path",
            "name": "feature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Setting deleted successfully"
          }
        },
        "summary": "Deletes specified setting by id and scope (global or certain project)",
        "tags": [
          "Settings"
        ]
      },
      "post": {
        "operationId": "renameSetting",
        "parameters": [
          {
            "in": "path",
            "name": "feature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Setting name updated successfully"
          }
        },
        "summary": "Updates name of specified named setting in specified scope (global or certain project)",
        "tags": [
          "Settings"
        ]
      }
    },
    "/api/settings/{feature}/names/{name}/content": {
      "get": {
        "operationId": "readSetting",
        "parameters": [
          {
            "in": "path",
            "name": "feature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "default": "",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsModel"
                }
              }
            },
            "description": "Setting content"
          }
        },
        "summary": "Returns values (content) of specified setting by its id, scope (global or certain project) and revision",
        "tags": [
          "Settings"
        ]
      },
      "put": {
        "operationId": "saveSetting",
        "parameters": [
          {
            "in": "path",
            "name": "feature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Setting created/updated successfully"
          }
        },
        "summary": "Creates or updates named setting in specified scope (global or certain project). Creation scenario will use default setting value if no body specified in the request.",
        "tags": [
          "Settings"
        ]
      }
    },
    "/api/settings/{feature}/names/{name}/revisions": {
      "get": {
        "operationId": "readRevisionsList",
        "parameters": [
          {
            "in": "path",
            "name": "feature",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "scope",
            "schema": {
              "default": "",
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            },
            "description": "List of revisions"
          }
        },
        "summary": "Returns revisions history of specified setting with specified id and in specified scope (global or certain project)",
        "tags": [
          "Settings"
        ]
      }
    },
    "/api/user-guide": {
      "get": {
        "operationId": "getUserGuide",
        "responses": {
          "default": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "HTML help article"
          }
        },
        "summary": "Returns the build-generated USER_GUIDE help article shown on the User Guide page",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/version": {
      "get": {
        "operationId": "getVersion",
        "responses": {
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            },
            "description": "Version information"
          }
        },
        "summary": "Returns version of Polarion's extension",
        "tags": [
          "Extension Information"
        ]
      }
    },
    "/api/work-item-types": {
      "get": {
        "operationId": "listWorkItemTypes",
        "parameters": [
          {
            "description": "Project ID",
            "in": "query",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TypeInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successfully retrieved the list of work item types"
          }
        },
        "summary": "Get list of work item types for the specified project",
        "tags": [
          "XML Repair"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BaselineInfo": {
        "description": "Baseline information",
        "properties": {
          "name": {
            "description": "The baseline name",
            "nullable": true,
            "type": "string"
          },
          "revision": {
            "description": "The SVN revision",
            "type": "string"
          }
        },
        "required": [
          "revision"
        ],
        "type": "object"
      },
      "ConfigurationPropertiesModel": {
        "description": "Extension configuration properties shown on the About page",
        "properties": {
          "obsoleteProperties": {
            "description": "Obsolete or non-valid configuration properties (only key and value are set), sorted by key",
            "items": {
              "$ref": "#/components/schemas/ConfigurationPropertyModel"
            },
            "type": "array"
          },
          "properties": {
            "description": "Active configuration properties, sorted by key",
            "items": {
              "$ref": "#/components/schemas/ConfigurationPropertyModel"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ConfigurationPropertyModel": {
        "description": "A single extension configuration property as shown on the About page",
        "properties": {
          "defaultValue": {
            "description": "Default value of the property, if any",
            "type": "string"
          },
          "description": {
            "description": "Human readable description of the property, if any",
            "type": "string"
          },
          "key": {
            "description": "Property key",
            "type": "string"
          },
          "value": {
            "description": "Current value of the property",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ConfigurationStatus": {
        "properties": {
          "details": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "OK",
              "WARNING",
              "ERROR"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Context": {
        "description": "Represents the context for building URLs related to Polarion services",
        "properties": {
          "baseUrl": {
            "description": "Returns the base URL constructed with the extension context",
            "type": "string"
          },
          "extensionContext": {
            "description": "The extension context used as a base for URL construction",
            "type": "string"
          },
          "restUrl": {
            "description": "Returns the REST API URL constructed with the extension context",
            "type": "string"
          },
          "swaggerUiUrl": {
            "description": "Returns the Swagger UI URL for the REST API",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RepairParams": {
        "properties": {
          "configs": {
            "additionalProperties": {
              "default": {},
              "description": "User custom repair configurations",
              "example": {
                "ModuleContentLinksRepairer": {
                  "convertToPlainText": true
                }
              },
              "type": "object"
            },
            "default": {},
            "description": "User custom repair configurations",
            "example": {
              "ModuleContentLinksRepairer": {
                "convertToPlainText": true
              }
            },
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "issueMetaInfos": {
            "description": "List of issues meta infos to fix",
            "items": {
              "description": "List of issues meta infos to fix",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "issueMetaInfos"
        ],
        "type": "object"
      },
      "RepairerConfigMeta": {
        "properties": {
          "defaultValue": {
            "type": "object"
          },
          "description": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "type": {
            "enum": [
              "BOOLEAN"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "RepairerMeta": {
        "properties": {
          "configs": {
            "items": {
              "$ref": "#/components/schemas/RepairerConfigMeta"
            },
            "type": "array"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Revision": {
        "description": "Revision details",
        "properties": {
          "author": {
            "description": "The author of the revision",
            "type": "string"
          },
          "baseline": {
            "description": "The baseline of the revision",
            "type": "string"
          },
          "date": {
            "description": "The date of the revision",
            "type": "string"
          },
          "description": {
            "description": "The description of the revision",
            "type": "string"
          },
          "name": {
            "description": "The name of the revision",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RolesInfo": {
        "description": "Available global and project roles for the current scope, used to configure repair authorization",
        "properties": {
          "globalRoles": {
            "description": "Global roles",
            "items": {
              "description": "Global roles",
              "type": "string"
            },
            "type": "array"
          },
          "projectRoles": {
            "description": "Project roles (empty when the scope is not a project)",
            "items": {
              "description": "Project roles (empty when the scope is not a project)",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "globalRoles",
          "projectRoles"
        ],
        "type": "object"
      },
      "ScanParams": {
        "properties": {
          "configs": {
            "additionalProperties": {
              "default": {},
              "description": "User custom repair configurations",
              "example": {
                "ModuleContentLinksRepairer": {
                  "convertToPlainText": true
                }
              },
              "type": "object"
            },
            "default": {},
            "description": "User custom repair configurations",
            "example": {
              "ModuleContentLinksRepairer": {
                "convertToPlainText": true
              }
            },
            "properties": {
              "empty": {
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "entitySubtype": {
            "description": "Entity subtype to scan, e.g. 'requirement' for work items or 'specification' for documents (if not provided, all subtypes will be scanned)",
            "nullable": true,
            "type": "string"
          },
          "entityType": {
            "description": "Entity prototype to scan. Currently supported values are: WORKITEM, DOCUMENT and COLLECTION",
            "enum": [
              "COLLECTION",
              "DOCUMENT",
              "WORKITEM"
            ],
            "example": "WORKITEM",
            "type": "string"
          },
          "hideValid": {
            "default": false,
            "description": "Hide entities without issues from the resulting list",
            "nullable": true,
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "description": "Maximum number of entities to scan",
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "projectId": {
            "description": "The unique identifier for the project",
            "example": "elibrary",
            "type": "string"
          },
          "repairers": {
            "description": "List of repairers to use (if no data provided the default repairers will be applied)",
            "items": {
              "description": "List of repairers to use (if no data provided the default repairers will be applied)",
              "nullable": true,
              "type": "string"
            },
            "nullable": true,
            "type": "array"
          },
          "revision": {
            "description": "SVN revision to scan against. If null, scans current HEAD; otherwise the entire query runs as of that revision.",
            "example": "12345",
            "nullable": true,
            "type": "string"
          },
          "sort": {
            "default": "created",
            "description": "Sorting criteria in the format 'created' or '~id'",
            "nullable": true,
            "type": "string"
          },
          "timeout": {
            "default": 60000,
            "description": "Operation timeout, milliseconds",
            "format": "int64",
            "type": "integer"
          },
          "userQuery": {
            "description": "Additional query to select entities for scanning, e.g. 'id:TEST-12345'",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "SettingName": {
        "properties": {
          "name": {
            "description": "The name of the setting",
            "type": "string"
          },
          "scope": {
            "description": "The scope of the setting",
            "type": "string"
          }
        },
        "type": "object"
      },
      "SettingsModel": {
        "description": "Settings model",
        "properties": {
          "bundleTimestamp": {
            "description": "The bundle timestamp of the setting",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TypeInfo": {
        "description": "Work item or document type information",
        "properties": {
          "iconURL": {
            "description": "The type icon URL",
            "nullable": true,
            "type": "string"
