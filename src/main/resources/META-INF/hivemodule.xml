<?xml version="1.0" encoding="UTF-8"?>
<module id="ch.sbb.polarion.extension.xml_repair" version="1.0.0">
    <contribution configuration-id="com.polarion.xray.webui.administrationPageExtenders">
        <extender id="about"
                  name="About"
                  parentNodeId="xml-repair"
                  parentNodeName="XML Repair"
                  parentNodeIconUrl="/polarion/xml-repair-admin/ui/images/menu/30x30/_parent.svg"
                  iconUrl="/polarion/xml-repair-admin/ui/images/menu/16x16/about.svg"
                  pageUrl="/polarion/xml-repair-app/ui/app/index.html?feature=about&amp;scope=$scope$&amp;embedded=true"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="rest-api"
                  name="REST API"
                  parentNodeId="xml-repair"
                  iconUrl="/polarion/xml-repair-admin/ui/images/menu/16x16/rest_api.svg"
                  pageUrl="/polarion/xml-repair/rest/swagger"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="true"/>

        <extender id="repair-authorization"
                  name="Repair Authorization"
                  parentNodeId="xml-repair"
                  iconUrl="/polarion/xml-repair-admin/ui/images/menu/16x16/authorization.svg"
                  pageUrl="/polarion/xml-repair-app/ui/app/index.html?feature=authorization&amp;scope=$scope$&amp;embedded=true"
                  projectScope="true"
                  projectGroupScope="false"
                  repositoryScope="false"/>

    </contribution>

    <contribution configuration-id="com.polarion.xray.webui.customNavigationExtenders">
        <extenders extender="xmlRepairNavigationExtender"/>
    </contribution>

    <service-point id="xmlRepairNavigationExtender" interface="com.polarion.alm.ui.server.navigation.NavigationExtender">
        <invoke-factory>
            <construct class="ch.sbb.polarion.extension.xml_repair.XmlRepairNavigationExtender"/>
        </invoke-factory>
    </service-point>

</module>
